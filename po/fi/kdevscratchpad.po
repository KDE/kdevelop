#: scratchpad.cpp:130 scratchpadview.cpp:88
#, kde-format
msgctxt "@title:window"
msgid "Scratchpad"
msgstr "Raapustuspöytä"

#: scratchpad.cpp:187
#, kde-format
msgid "Failed to remove scratch: %1"
msgstr "Raapustuksen poistaminen epäonnistui: %1"

#: scratchpad.cpp:194
#, kde-format
msgid "Failed to create scratch: Name already in use"
msgstr "Raapustuksen luominen epäonnistui: nimi on jo käytössä"

#: scratchpad.cpp:206
#, kde-format
msgid "Failed to create new scratch"
msgstr "Uutta raapustusta ei voitu luoda"

#: scratchpad.cpp:215
#, kde-format
msgid "Failed to rename scratch: Names must not include path separator"
msgstr ""
"Raapustuksen nimen muuttaminen epäonnistui: nimi ei saa sisältää "
"kansioerotinta"

#: scratchpad.cpp:256
#, kde-format
msgid "Failed renaming scratch."
msgstr "Raapustuksen nimen muuttaminen epäonnistui."

#: scratchpad.cpp:299 scratchpadjob.cpp:33
#, kde-format
msgctxt "prefix to distinguish scratch tabs"
msgid "scratch:%1"
msgstr "raapustus:%1"

#: scratchpadjob.cpp:57
#, kde-format
msgid "Running %1..."
msgstr "Suoritetaan: %1…"

#: scratchpadjob.cpp:73
#, kde-format
msgid "Process finished with exit code %1."
msgstr "Prosessi päättyi paluukoodiin %1."

#: scratchpadjob.cpp:80
#, kde-format
msgid "Failed to run scratch: %1"
msgstr "Raapustusta ei voitu suorittaa: %1"

#: scratchpadview.cpp:101
#, kde-format
msgid ""
"Scratchpad lets you quickly run and experiment with code without a full "
"project, and even store todos. Create a new scratch to start."
msgstr ""
"Raapustuspöydällä voi nopeasti suorittaa ja kokeilla koodia projektitta ja "
"jopa tallettamatta tehtäviä. Aloita luomalla uusi raapustus."

#: scratchpadview.cpp:115
#, kde-format
msgctxt "@info:tooltip"
msgid "Command to run this scratch. '$f' will expand to the scratch path."
msgstr ""
"Komento raapustuksen suorittamiseksi. ”$f” lavennetaan raapustuksen "
"sijainniksi."

#: scratchpadview.cpp:138
#, kde-format
msgctxt "@action"
msgid "New Scratch"
msgstr "Uusi raapustus"

#: scratchpadview.cpp:142
#, kde-format
msgctxt "@action"
msgid "Remove Scratch"
msgstr "Poista raapustus"

#: scratchpadview.cpp:153
#, kde-format
msgctxt "@action"
msgid "Rename Scratch"
msgstr "Muuta raapustuksen nimeä"

#: scratchpadview.cpp:162
#, kde-format
msgctxt "@action"
msgid "Run Scratch"
msgstr "Suorita raapustus"

#: scratchpadview.cpp:168
#, kde-format
msgctxt "@info:placeholder"
msgid "Filter..."
msgstr "Suodata…"

#: scratchpadview.cpp:210
#, kde-format
msgctxt "@title:window"
msgid "Create New Scratch"
msgstr "Luo uusi raapustus"

#: scratchpadview.cpp:211
#, kde-format
msgctxt "@label:textbox"
msgid "Name for scratch file:"
msgstr "Raapustustiedoston nimi:"
