#: astyle_plugin.cpp:249
#, kde-format
msgid ""
"<b>Artistic Style</b> is a source code indenter, formatter, and beautifier "
"for the C, C++, C# and Java programming languages.<p style='margin-top:0;"
"white-space:pre'>Home Page: <a href=\"http://astyle.sourceforge.net/"
"\">http://astyle.sourceforge.net</a></p>"
msgstr ""
"<b>Artistic Style</b> je nástroj pro odsazování, formátování a zkrášlování "
"zdrojového kódu v programovacích jazycích C, C++, C# a Java.<p style='margin-"
"top:0;white-space:pre'>Domovská stránka: <a href=\"http://astyle.sourceforge."
"net/\">http://astyle.sourceforge.net</a></p>"

