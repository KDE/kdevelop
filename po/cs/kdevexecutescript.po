#: scriptappconfig.ui:298
#, kde-format
msgctxt "@info:placeholder"
msgid "user@host"
msgstr "uzivatel@hostitel"

#. i18n: ectx: property (toolTip), widget (QLineEdit, remoteHost)
#: scriptappconfig.ui:301
#, kde-format
msgctxt "@info:tooltip"
msgid "Enter a remote host (user@host)"
msgstr "Zadejte vzdáleného hostitele (uživatel@hostitel)"

#: scriptappjob.cpp:43
#, kde-format
msgid ""
"No environment profile specified, looks like a broken configuration, please "
"check run configuration '%1'. Using default environment profile."
msgstr ""
"Není zadán žádný profil prostředí, zdá se, že konfigurace je poškozená. "
"Zkontrolujte prosím konfiguraci spuštění '%1'. Používá se výchozí profil "
"prostředí."

#: scriptappjob.cpp:90
#, kde-format
msgid "There is no active document to launch."
msgstr "Neexistuje žádný aktivní dokument, který by bylo možné spustit."

#: scriptappjob.cpp:165
#, kde-format
msgid "Starting: %1"
msgstr "Spouštění: %1"

#: scriptappjob.cpp:179
#, kde-format
msgid "*** Killed Application ***"
msgstr "*** Zabitá aplikace ***"

#: scriptappjob.cpp:190
#, kde-format
msgid "*** Exited normally ***"
msgstr "*** Ukončeno normálně ***"

#: scriptappjob.cpp:192
#, kde-format
msgid "*** Exited with return code: %1 ***"
msgstr "*** Ukončeno s návratovým kódem: %1 ***"

#: scriptappjob.cpp:195
#, kde-format
msgid "*** Process aborted ***"
msgstr "*** Proces byl přerušen ***"

#: scriptappjob.cpp:198
#, kde-format
msgid "*** Crashed with return code: %1 ***"
msgstr "*** Došlo k selhání s návratovým kódem: %1 ***"

#: scriptappjob.cpp:213
#, kde-format
msgid ""
"*** Could not start program '%1'. Make sure that the path is specified "
"correctly ***"
msgstr ""
"*** Nelze spustit program '%1'. Zkontrolujte, zda je cesta zadána správně ***"
