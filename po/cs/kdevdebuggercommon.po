#: midebugger.cpp:319
#, kde-format
msgctxt "<b>Internal debugger error</b>"
msgid ""
"<p>The debugger component encountered an internal error while processing the "
"reply from the debugger. Please submit a bug report. The debug session will "
"now end to prevent potential crash"
msgstr ""
"<p>Komponenta ladicího programu narazila při zpracování odpovědi od ladicího "
"programu na interní chybu. Prosím, odešlete hlášení o chybě. Ladicí relace "
"bude nyní ukončena, aby se předešlo možnému selhání"

#: midebugger.cpp:322
#, kde-format
msgid ""
"The exception is: %1\n"
"The MI response is: %2"
msgstr ""
"Výjimka je: %1\n"
"Odpověď MI je: %2"

